{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/vendor.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/about", "destination": "/about-darshan/index.html" },
    { "source": "/about-me", "destination": "/about-darshan/index.html" },
    { "source": "/about-darshan", "destination": "/about-darshan/index.html" },
    { "source": "/about-deztopia", "destination": "/about-darshan/index.html" },
    { "source": "/portfolio", "destination": "/darshan-design-portfolio/index.html" },
    { "source": "/work", "destination": "/darshan-design-portfolio/index.html" },
    { "source": "/darshan-design-portfolio", "destination": "/darshan-design-portfolio/index.html" },
    { "source": "/deztopia-design-portfolio", "destination": "/darshan-design-portfolio/index.html" },
    { "source": "/service", "destination": "/service/index.html" },
    { "source": "/services", "destination": "/service/index.html" },
    { "source": "/for-startups", "destination": "/service/index.html" },
    { "source": "/darshan", "destination": "/darshan/index.html" },
    { "source": "/darshan/", "destination": "/darshan/index.html" },
    { "source": "/celebrations", "destination": "/celebrations/index.html" },
    { "source": "/celebrations/", "destination": "/celebrations/index.html" },
    { "source": "/gsap", "destination": "/gsap/index.html" },
    { "source": "/contact", "destination": "/contact-darshan/index.html" },
    { "source": "/contact-darshan", "destination": "/contact-darshan/index.html" },
    { "source": "/contact-deztopia", "destination": "/contact-darshan/index.html" },
    { "source": "/projects/:slug", "destination": "/projects/:slug/index.html" },
    { "source": "/project/:slug", "destination": "/projects/:slug/index.html" },
    { "source": "/projects/obvio", "destination": "/projects/obvio/index.html" },
    { "source": "/projects/across", "destination": "/projects/across/index.html" },
    { "source": "/projects/roomie", "destination": "/projects/roomie/index.html" },
    { "source": "/projects/basilica", "destination": "/projects/basilica/index.html" },
    { "source": "/projects/rendezvu", "destination": "/projects/rendezvu/index.html" },
    { "source": "/projects/travel-posters", "destination": "/projects/travel-posters/index.html" },
    { "source": "/project/travel-posters", "destination": "/projects/travel-posters/index.html" },
    { "source": "/project/obvio", "destination": "/projects/obvio/index.html" },
    { "source": "/project/across", "destination": "/projects/across/index.html" },
    { "source": "/project/roomie", "destination": "/projects/roomie/index.html" },
    { "source": "/project/basilica", "destination": "/projects/basilica/index.html" },
    { "source": "/project/rendezvu", "destination": "/projects/rendezvu/index.html" }
  ]
}
